generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified Boolean?  @default(false)
  image         String?
  password      String?
  role      Role      @default(STAFF) // OWNER, STAFF
  member    Member?
  payments  Payment[]
  sessions  Session[]
  accounts  Account[]
  auditLogs AuditLog[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum Role {
  OWNER
  STAFF
}

// ... keeping the rest the same ...

model SystemSettings {
  id           String  @id @default("default")
  lockdownMode Boolean @default(false)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String   // e.g. "MEMBER_CREATE", "PAYMENT_RECORDED", etc
  entityType String   // "Member", "Payment", "Membership", "Plan"
  entityId   String
  details    String?  // JSON diff or summary
  createdAt  DateTime @default(now())
}

model Member {
  id           String          @id @default(cuid())
  barcode      String          @unique
  deviceUserId String?         @unique
  firstName    String
  lastName     String
  phone        String?
  photoUrl     String?
  isBlocked    Boolean         @default(false)
  isArchived   Boolean         @default(false)
  biometricEnrolled Boolean    @default(false)
  biometricRef String?
  userId      String?         @unique
  user        User?           @relation(fields: [userId], references: [id])
  memberships Membership[]
  attendance  Attendance[]
  deniedLogs  DeniedAttempt[]
  createdAt   DateTime        @default(now())
}

model Plan {
  id           String       @id @default(cuid())
  name         String
  durationDays Int
  priceCents   Int
  memberships  Membership[]
}

model Membership {
  id       String           @id @default(cuid())
  memberId String
  planId   String
  startsAt DateTime
  endsAt   DateTime
  status   MembershipStatus @default(ACTIVE) // ACTIVE, EXPIRED, FROZEN
  frozenAt DateTime?        // Set when frozen; used to extend endsAt on unfreeze
  payments Payment[]
  member   Member           @relation(fields: [memberId], references: [id])
  plan     Plan             @relation(fields: [planId], references: [id])

  @@index([memberId])
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  FROZEN
}

model Payment {
  id           String     @id @default(cuid())
  membershipId String
  amountCents  Int
  method       String
  paidAt       DateTime   @default(now())
  recordedById String
  membership   Membership @relation(fields: [membershipId], references: [id])
  recordedBy   User       @relation(fields: [recordedById], references: [id])
}

model Attendance {
  id          String    @id @default(cuid())
  memberId    String
  checkInAt   DateTime  @default(now())
  checkInDate DateTime  @db.Date
  method      String    @default("BARCODE")
  member      Member    @relation(fields: [memberId], references: [id])

  @@unique([memberId, checkInDate])
  @@index([checkInDate])
}

model DeniedAttempt {
  id        String   @id @default(cuid())
  memberId  String?
  barcode   String
  reason    String
  scannedAt DateTime @default(now())
  member    Member?  @relation(fields: [memberId], references: [id])

  @@index([scannedAt])
}

// better-auth required tables
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuer                String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}
